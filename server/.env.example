# Dispositivos autorizados: Nombre:password separados por comas. El nombre es el
# SSID del portal del dispositivo (Semaforo-XXXXXX) y la password la de esa red
# WiFi (sale por el log serie al abrir el portal). Son tambien el usuario y la
# password para entrar en la web app.
DEVICES=Semaforo-A1B2C3:12345678

# Clave para firmar las cookies de sesion. Sin ella se genera una al arrancar y
# todas las sesiones caducan en cada reinicio del contenedor.
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
