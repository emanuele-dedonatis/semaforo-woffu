# Clave para firmar las cookies de sesion. Sin ella se genera una al arrancar y
# todas las sesiones caducan en cada reinicio del contenedor.
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Los dispositivos no se configuran aqui: se registran solos la primera vez que
# se conectan (ver README.md). Maximo de dispositivos registrados:
MAX_DEVICES=20
